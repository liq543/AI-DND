{
  "permissions": {
    "allow": [
      "Bash(python -m engine:*)",
      "PowerShell(python -m engine:*)",
      "PowerShell(py -m engine:*)",
      "Bash(py -m engine:*)",
      "Bash(python -m unittest:*)",
      "Bash(py -m unittest:*)",
      "Read(./rules/**)",
      "Read(./dm/**)",
      "Read(./campaigns/**)",
      "Edit(./campaigns/*/campaign.md)",
      "Edit(./campaigns/*/npcs.md)",
      "Edit(./campaigns/*/locations.md)",
      "Edit(./campaigns/*/quests.md)",
      "Edit(./campaigns/*/secrets.md)",
      "Edit(./campaigns/*/log/**)",
      "Write(./campaigns/*/log/**)"
    ],
    "deny": [
      "Read(./campaigns/_archive/**)",
      "Edit(./campaigns/_archive/**)",
      "Write(./campaigns/_archive/**)",
      "Edit(./campaigns/*/engine/**)",
      "Write(./campaigns/*/engine/**)",
      "Edit(./campaigns/*/state.md)",
      "Write(./campaigns/*/state.md)",
      "Edit(./campaigns/*/party/**)",
      "Write(./campaigns/*/party/**)",
      "Edit(./campaigns/ACTIVE)",
      "Write(./campaigns/ACTIVE)",
      "Read(~/.dnd-engine/**)",
      "Edit(~/.dnd-engine/**)",
      "Write(~/.dnd-engine/**)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(py -c:*)",
      "PowerShell(python -c:*)",
      "PowerShell(py -c:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks/dm_rules.py\"; py \"$H\" UserPromptSubmit 2>/dev/null || python3 \"$H\" UserPromptSubmit 2>/dev/null || python \"$H\" UserPromptSubmit 2>/dev/null || cat \"$CLAUDE_PROJECT_DIR/dm/turn-rules.md\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks/dm_rules.py\"; py \"$H\" SessionStart 2>/dev/null || python3 \"$H\" SessionStart 2>/dev/null || python \"$H\" SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks/dm_rules.py\"; py \"$H\" PreToolUse 2>/dev/null || python3 \"$H\" PreToolUse 2>/dev/null || python \"$H\" PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks/dm_rules.py\"; py \"$H\" Stop 2>/dev/null || python3 \"$H\" Stop 2>/dev/null || python \"$H\" Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
